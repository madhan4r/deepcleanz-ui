# MongoDB — must be a replica set (MongoDB Atlas free tier works as-is).
# Local Docker: mongodb://localhost:27017/deepcleanz?replicaSet=rs0&directConnection=true
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/deepcleanz

# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob for public images in production (leave empty locally → images saved to disk)
BLOB_READ_WRITE_TOKEN=

# Optional: create the owner login when running `npm run seed`
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# New-booking email alerts (optional). Any SMTP works, e.g. Gmail with an app password,
# Zoho Mail, or your domain's mail host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where new-booking alerts go (comma-separated for several people)
ALERT_EMAIL=
