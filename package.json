{
  "name": "deepcleanz",
  "version": "1.0.0",
  "description": "DeepCleanz website and admin (Next.js + Payload CMS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "prices": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/prices.ts",
    "policies": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/publish-policies.ts",
    "settings": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/apply-settings.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "graphql": "^16.15.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
